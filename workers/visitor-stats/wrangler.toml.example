name = "csma-visitor-stats"
main = "src/index.js"
compatibility_date = "2026-05-19"

[[d1_databases]]
binding = "DB"
database_name = "csma-visitor-stats"
database_id = "replace-with-your-database-id"

# Browser origins permitted to call the public API. Separate multiple origins with commas.
[vars]
ALLOWED_ORIGIN = "https://csma-research-group.github.io,http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173"
